<Window x:Class="osu_fetcher.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="osu!fetcher" Height="660" Width="1340"
        MinHeight="500" MinWidth="900"
        Background="{StaticResource BgDark}"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize">

    <Border CornerRadius="12" ClipToBounds="True" Background="{StaticResource BgDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgMid}" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Ellipse x:Name="i_can_hear_the_song_playing____" Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="0,0,8,0" ClipToBounds="False" Cursor="Wait" IsEnabled="False" RenderTransformOrigin="0.5,0.5" Opacity="0.8">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="osu!fetcher" FontSize="12" FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="FetchStatusText" Text="" FontSize="11"
                       Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar x:Name="FetchProgress" Width="160" Height="4" Visibility="Collapsed"
                         Background="#22ffffff" Foreground="{StaticResource Accent}"
                         BorderThickness="0" Minimum="0" Maximum="100"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Content="─" Style="{StaticResource BtnGhost}" FontSize="10"
                    Click="MinimizeClick" Padding="10,5">
                            <Button.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF171734"/>
                                    <GradientStop Color="#FF1A1A2E" Offset="1"/>
                                </RadialGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button Content="✕" Style="{StaticResource BtnGhost}" FontSize="10" Click="CloseClick" Padding="10,5">
                            <Button.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF171734"/>
                                    <GradientStop Color="#FF1A1A2E" Offset="1"/>
                                </RadialGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#FF343030" CornerRadius="12,0,12,12" BorderThickness="0,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                    <RotateTransform Angle="80" CenterX="0.5" CenterY="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF39393B"/>
                            <GradientStop Color="#FF12121C" Offset="1"/>
                            <GradientStop Color="#FF2A2A48" Offset="0.761"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="14,18,14,12">
                            <Border CornerRadius="40" Width="64" Height="64" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Image x:Name="SidebarAvatar" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="SidebarUsername" Text="N/A"
                         FontSize="14" FontFamily="Segoe UI Semibold"
                         HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="SidebarRank" Text=""
                         FontSize="11" Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="SidebarPP" Text=""
                         FontSize="11" Foreground="{StaticResource TextSoft}"
                         HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle DockPanel.Dock="Top" Height="1"
                       Fill="{StaticResource Border}" Margin="14,0,14,10"/>

                        <StackPanel DockPanel.Dock="Top" Margin="8,0">
                            <Button x:Name="BtnProfile"   Content="📊   Profile"      Tag="Profile" Style="{StaticResource BtnNav}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button x:Name="BtnScores"    Content="🎯   Best Scores"  Tag="Scores" Style="{StaticResource BtnGhost}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button x:Name="BtnRecent"    Content="🕐   Recent"       Tag="Recent" Style="{StaticResource BtnGhost}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button x:Name="BtnAllScores" Content="📋   All Scores"   Tag="AllScores" Style="{StaticResource BtnGhost}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Button x:Name="BtnGraphs"    Content="📈   Graphs"       Tag="Graphs" Style="{StaticResource BtnGhost}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            <Rectangle Height="1" Fill="{StaticResource Border}" Margin="8,10"/>
                            <Button x:Name="BtnSettings"  Content="⚙   Settings"      Tag="Settings" Style="{StaticResource BtnGhost}" Click="NavClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,14">
                            <Rectangle Height="3" Margin="4,0,4,10">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="#FF828495" Opacity="0.2"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <CheckBox x:Name="ChkAutoFetch" Content="Enable Auto-Fetch on Startup" Checked="AutoFetch_Changed" Unchecked="AutoFetch_Changed" Padding="3, 0 ,0, 12" Height="33" FontSize="10" Opacity="0.8"/>
                            <Button x:Name="BtnFetch" Content="⟳  Fetch Data" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch" Click="FetchClick" Background="#FFDF8C9E" FontSize="18" FontWeight="Bold" FontStyle="Italic" Opacity="0.9"/>
                        </StackPanel>

                        <Grid/>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" x:Name="PageHost" Margin="22,18,22,18">

                    <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel MaxWidth="540" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" FontSize="20" FontFamily="Segoe UI Bold" Margin="0,0,0,20"/>

                            <TextBlock Text="osu! OAuth Credentials" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Get your credentials from osu.ppy.sh → Settings → OAuth → New OAuth Application" FontSize="11" Foreground="{StaticResource TextSoft}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Client ID" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtClientId" Margin="0,0,0,10"/>
                                    <TextBlock Text="Client Secret" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtClientSecret" Margin="0,0,0,10"/>
                                    <TextBlock Text="User ID" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="TxtUserId" PreviewKeyDown="UserId_KeyDown" TextChanged="TxtUserId_TextChanged"/>
                                        <TextBlock x:Name="UserIdGhost" Text="18960406" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" FontFamily="Segoe UI"/>
                                    </Grid>

                                    <TextBlock Text="Mode" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbMode" Margin="0,0,0,16" Background="#1a1e35" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}">
                                        <ComboBoxItem Content="osu"   IsSelected="True"/>
                                        <ComboBoxItem Content="taiko"/>
                                        <ComboBoxItem Content="fruits"/>
                                        <ComboBoxItem Content="mania"/>
                                    </ComboBox>

                                    <Button Content="Save &amp; Test Connection" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Click="SaveSettingsClick"/>
                                    <TextBlock x:Name="SettingsStatus" Text="" FontSize="12" Margin="0,10,0,0" Foreground="{StaticResource Accent}"/>

                                    <TextBlock Text="Terminal Log" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,14,0,4"/>
                                    <Border Background="#0e101f" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Height="170">
                                        <TextBox x:Name="TxtSettingsLog" Background="Transparent" Foreground="#a4a9c6" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="osu!fetcher" FontSize="14" FontFamily="Segoe UI Semibold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Personal osu! profile viewer with full score pagination." FontSize="12" Foreground="{StaticResource TextSoft}"/>
                                    <TextBlock Text="Made by NCD NLO" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageProfile" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel x:Name="ProfileContent">
                            <Grid Margin="0,0,0,20">
                                <Border Height="180" CornerRadius="8" ClipToBounds="True">
                                    <Image x:Name="CoverImage" Stretch="UniformToFill" Cursor="None"/>
                                </Border>
                                <Border CornerRadius="0,0,8,8" VerticalAlignment="Bottom" Padding="16,10">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#00000000"/>
                                            <GradientStop Color="#1E9898A6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                   
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="32" Width="64" Height="64" ClipToBounds="True" Margin="0,0,16,0" BorderBrush="{StaticResource Border}" BorderThickness="2">
                                            <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UsernameText" Text="Loading..." FontSize="20" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="RankText" Text="#0" FontSize="14" Foreground="{StaticResource Accent}" FontFamily="Segoe UI Semibold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Performance &amp; Ranks" Style="{StaticResource SectionHeader}"/>
                            <UniformGrid Columns="4" Margin="0,0,0,16" Background="#FF8D8D8D" Opacity="0.77" Cursor="None">
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Total PP" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatPP" Text="0pp" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Global Rank" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatRank" Text="#0" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Country Rank" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatCountryRank" Text="#0" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Accuracy" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatAcc" Text="0.00%" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,0,0,20" Background="#FF805C5C">
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Play Count" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatPlays" Text="0" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Play Time" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatPlayTime" Text="0h" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Max Combo" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatMaxCombo" Text="0x" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Current Level" FontSize="11" Foreground="{StaticResource TextSoft}"/>
                                        <TextBlock x:Name="StatLevel" Text="0" FontSize="16" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Grade Counts" Style="{StaticResource SectionHeader}" Foreground="#FFBEBEBE"/>
                                    <Border Style="{StaticResource Card}" Padding="12">
                                        <UniformGrid Columns="5">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SSH" FontSize="10" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                </TextBlock>
                                                <TextBlock x:Name="GradeSSH" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="#F0E6D2" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SS" FontSize="10" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="GradeSS" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="Gold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SH" FontSize="10" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="GradeSH" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="#D1D1E0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="S" FontSize="10" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="GradeS" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="Orange" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="A" FontSize="10" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="GradeA" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="#44DD88" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="Achievements" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" Foreground="#FFBEBEBE"/>
                                    <Border Style="{StaticResource Card}" BorderBrush="#FF5F627B" BorderThickness="3,3,3,3">
                                        <WrapPanel x:Name="AchievementsContent" Orientation="Horizontal" Width="520">
                                            <TextBlock Text="No achievements loaded." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="8"/>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Hit Precision" Style="{StaticResource SectionHeader}" Foreground="#FFBEBEBE"/>

                                    <Border Style="{StaticResource Card}" Padding="12">
                                        <UniformGrid Columns="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="300" FontSize="10" Foreground="{DynamicResource GradeSH}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="Hit300" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="100" FontSize="10" Foreground="{DynamicResource GradeA}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="Hit100" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="50" FontSize="10" Foreground="#FFCEBE57" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="Hit50" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Miss" FontSize="10" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="HitMiss" Text="0" FontSize="14" FontFamily="Segoe UI Bold" Foreground="#FF6B8A" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageScores" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Best Scores" FontSize="18" FontFamily="Segoe UI Bold" Margin="0,0,0,14"/>
                            <StackPanel x:Name="ScoresList"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageRecent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Recent Scores" FontSize="18" FontFamily="Segoe UI Bold" Margin="0,0,0,14"/>
                            <StackPanel x:Name="RecentList"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageAllScores" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All Scores" FontSize="18" FontFamily="Segoe UI Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AllScoresCount" Text="" FontSize="12"
                             Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="⟳ Fetch All (paginate)" Style="{StaticResource BtnPrimary}"
                          Click="FetchAllScoresClick" Padding="14,8"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="AllScoresList"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageGraphs" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="GraphsContent">
                            <TextBlock Text="Rank History" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Height="200" Margin="0,0,0,16" Padding="8">
                                <lvc:CartesianChart x:Name="RankChart"/>
                            </Border>

                            <TextBlock Text="Monthly Play Counts" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Height="200" Margin="0,0,0,16" Padding="8">
                                <lvc:CartesianChart x:Name="PlayChart"/>
                            </Border>

                            <TextBlock Text="PP Distribution" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Height="200" Padding="8">
                                <lvc:CartesianChart x:Name="PPChart"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>